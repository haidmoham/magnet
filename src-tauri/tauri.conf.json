{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnet Player",
  "version": "0.1.0-alpha.2",
  "identifier": "dev.haidmoham.magnet-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magnet Player",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
